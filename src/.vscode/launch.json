{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "type": "gdb",
            "request": "attach",
            "gdbpath": "/home/fdumais/arm-cross-comp-env/arm-raspbian-linux-gnueabi/bin/arm-raspbian-linux-gnueabi-gdb",
            "name": "Debogage distant avec gdbserver",
            "executable": "./build/SETR_TP1",
            "target": "192.168.43.240:12345",
            "remote": true,
            "autorun": [
                "set sysroot /home/fdumais/arm-cross-comp-env/arm-raspbian-linux-gnueabi/arm-raspbian-linux-gnueabi/sysroot/"
            ],
            "cwd": "${workspaceRoot}",
            // "preLaunchTask": "syncAndStartGDB" 
        },
        {
              "name": "Remote GDB",
              "type": "cppdbg",
              "request": "launch",
              "program": "./build/SETR_TP1",
              "miDebuggerServerAddress": "192.168.43.240:12345",
              "miDebuggerPath": "/home/fdumais/arm-cross-comp-env/arm-raspbian-linux-gnueabi/bin/arm-raspbian-linux-gnueabi-gdb",
              "targetArchitecture": "arm64",
              "cwd": "${workspaceRoot}",
              "externalConsole": false,
              "MIMode": "gdb",
              "setupCommands": [
                {
                  "description": "Enable pretty-printing for gdb",
                  "text": "-enable-pretty-printing",
                  "ignoreFailures": true
                },
              ],
              "preLaunchTask": "syncAndStartGDB" 
            }
    ]
}
